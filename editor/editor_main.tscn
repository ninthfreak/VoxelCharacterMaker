[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://editor/editor_main.gd" id="1_editor"]

; Deliberately a bare root: editor_main.gd builds the whole UI in code.
; See the note at the top of that script and docs/NOTES.md.

[node name="CharacterEditor" type="Control"]
